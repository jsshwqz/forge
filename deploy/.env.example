# Aion Forge 容器化部署环境变量示例
# 复制为 deploy/.env 后填写。.env 已 gitignore，严禁提交密钥。
# 生成强随机 key 示例: openssl rand -hex 32

# 服务绑定地址（默认 127.0.0.1，生产改为 0.0.0.0 并配 FORGE_API_KEY）
FORGE_HOST=127.0.0.1

# 服务端口（默认 8080）
FORGE_PORT=8080

# API 密钥（非 loopback 时必须配置，SEC-001）
FORGE_API_KEY=change-me-to-a-long-random-secret

# PostgreSQL 连接串（不配则使用内存模式）
FORGE_PG_URL=postgres://postgres:forge@postgres:5432/forge

# MinIO 凭据（compose 内部已设默认）
# FORGE_S3_ACCESS_KEY=forgeminio
# FORGE_S3_SECRET_KEY=forgeminio123

# 浏览器跨域白名单(逗号分隔)。留空 = 完全关闭 CORS
FORGE_CORS_ORIGINS=
